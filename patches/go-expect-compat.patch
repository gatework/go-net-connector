new file mode 100644
--- /dev/null
+++ b/compat.go
@@ -0,0 +1,218 @@
+package expect
+
+import (
+	"context"
+	"errors"
+	"io"
+)
+
+// Poll matches buffered bytes and performs one OS readiness pass without waiting
+// for future input. No match returns ErrTimeout. A zero Expect timeout instead
+// disables that timer and continues waiting. Requires WithOSPolling.
+func (s *Session) Poll(ctx context.Context, cases []Case, opts ...ExpectOption) (Result, error) {
+	if s.osIO == nil {
+		return Result{CaseIndex: -1}, ErrPollUnsupported
+	}
+	opts = append(append([]ExpectOption(nil), opts...), func(o *expectOptions) error { o.poll = true; return nil })
+	return s.Expect(ctx, cases, opts...)
+}
+
+func (s *Session) acceptEvent(event readEvent) error {
+	s.staged = event.data
+	s.stagedErr = event.err
+	if len(event.data) == 0 && event.err != nil {
+		s.terminal = event.err
+		s.stagedErr = nil
+		return s.emit(nil, true)
+	}
+	return nil
+}
+
+// SendAll writes only the unsent suffix after positive partial writes. Its
+// context owns the complete deadline, including serialization; WithWriteTimeout
+// applies only to Send. Receive data is queued up to WithBufferLimit while the
+// peer writes before reading. Exceeding that bound fails instead of deadlocking.
+// Every error after transport entry closes the Session and reports total progress.
+func (s *Session) SendAll(ctx context.Context, text string) (int, error) {
+	return s.sendAll(ctx, text, false)
+}
+
+// SendAllPoll uses immediate OS write readiness for every suffix, permitting an
+// initial write without waiting. A blocked suffix returns ErrTimeout with total
+// progress and closes the Session. Requires WithOSPolling.
+func (s *Session) SendAllPoll(ctx context.Context, text string) (int, error) {
+	if s.osIO == nil {
+		return 0, ErrPollUnsupported
+	}
+	return s.sendAll(ctx, text, true)
+}
+func (s *Session) sendAll(ctx context.Context, text string, poll bool) (n int, err error) {
+	defer func() { s.notify(Event{Operation: "send_all", CaseIndex: -1, Bytes: n, Error: errorClass(err)}) }()
+	if ctx == nil {
+		return 0, errors.New("expect: nil context")
+	}
+	if err = ctx.Err(); err != nil {
+		return 0, err
+	}
+	select {
+	case s.writeGate <- struct{}{}:
+		defer func() { <-s.writeGate }()
+	case <-ctx.Done():
+		return 0, ctx.Err()
+	case <-s.done:
+		return 0, ErrClosed
+	}
+	if err = ctx.Err(); err != nil {
+		return 0, err
+	}
+	if s.isClosed() {
+		return 0, ErrClosed
+	}
+	if len(text) == 0 {
+		return 0, nil
+	}
+	s.lifeMu.Lock()
+	if s.isClosed() {
+		s.lifeMu.Unlock()
+		return 0, ErrClosed
+	}
+	results := make(chan writeResult, 1)
+	s.workers.Add(1)
+	go func() {
+		defer s.workers.Done()
+		total := 0
+		var e error
+		for total < len(text) {
+			if e = ctx.Err(); e != nil {
+				break
+			}
+			var count int
+			if poll {
+				count, e = s.osIO.writeNow([]byte(text[total:]))
+			} else {
+				count, e = s.transport.Write([]byte(text[total:]))
+			}
+			if count < 0 || count > len(text)-total {
+				count = 0
+				e = errors.Join(errors.New("expect: invalid write count"), e)
+			}
+			total += count
+			if e != nil {
+				break
+			}
+			if count == 0 {
+				e = io.ErrNoProgress
+				break
+			}
+		}
+		results <- writeResult{total, e}
+	}()
+	s.lifeMu.Unlock()
+	// Drain without competing with an active Expect receive. The input gate also
+	// preserves order when a later Expect claims queued input.
+	events := s.events
+	s.signalInput() // Inspect already published input before relying on future notifications.
+	for {
+		select {
+		case r := <-results:
+			n, err = r.n, r.err
+			if stop := ctx.Err(); stop != nil {
+				err = errors.Join(stop, err)
+			} else if s.isClosed() {
+				err = errors.Join(ErrClosed, err)
+			}
+			if err != nil {
+				s.Close()
+				return n, &WriteError{Written: n, Cause: err}
+			}
+			return n, nil
+		case <-ctx.Done():
+			s.Close()
+			r := <-results
+			return r.n, &WriteError{Written: r.n, Cause: errors.Join(ctx.Err(), r.err)}
+		case <-s.done:
+			r := <-results
+			return r.n, &WriteError{Written: r.n, Cause: errors.Join(ErrClosed, r.err)}
+		case <-s.inputReady:
+			// Reserve ownership only after a readiness notification, and never hold
+			// it while waiting for future input. Existing queued bytes stay visible.
+			select {
+			case s.inputGate <- struct{}{}:
+				select {
+				case event, ok := <-events:
+					if !ok {
+						events = nil
+					}
+					if ok {
+						if e := s.queueEvent(event); e != nil {
+							<-s.inputGate
+							s.Close()
+							r := <-results
+							return r.n, &WriteError{Written: r.n, Cause: errors.Join(e, r.err)}
+						}
+					}
+				default:
+				}
+				<-s.inputGate
+			case r := <-results:
+				n, err = r.n, r.err
+				if stop := ctx.Err(); stop != nil {
+					err = errors.Join(stop, err)
+				} else if s.isClosed() {
+					err = errors.Join(ErrClosed, err)
+				}
+				if err != nil {
+					s.Close()
+					return n, &WriteError{Written: n, Cause: err}
+				}
+				return n, nil
+			case <-ctx.Done():
+				s.Close()
+				r := <-results
+				return r.n, &WriteError{Written: r.n, Cause: errors.Join(ctx.Err(), r.err)}
+			case <-s.done:
+				r := <-results
+				return r.n, &WriteError{Written: r.n, Cause: errors.Join(ErrClosed, r.err)}
+			}
+		}
+	}
+}
+
+// queueEvent coalesces the queued stream into one ownership unit: at most limit
+// payload capacity plus one fixed readEvent header, regardless of read sizes.
+// The input gate protects both queue mutation and dequeue order. A terminal
+// event belongs after all its bytes and therefore remains at the coalesced end.
+func (s *Session) queueEvent(event readEvent) error {
+	if len(event.data) == 0 && event.err == nil {
+		return nil
+	}
+	if s.queuedBytes+len(event.data) > s.opts.limit {
+		return ErrBufferLimit
+	}
+	if len(s.queued) == 0 {
+		data := event.data
+		if cap(data) > s.opts.limit {
+			data = make([]byte, len(event.data))
+			copy(data, event.data)
+		}
+		s.queued = []readEvent{{data: data, err: event.err}}
+		s.queuedBytes = len(data)
+		return nil
+	}
+	queued := &s.queued[0]
+	size := len(queued.data) + len(event.data)
+	if size > cap(queued.data) {
+		capacity := min(s.opts.limit, max(size, 2*cap(queued.data)))
+		data := make([]byte, size, capacity)
+		copy(data, queued.data)
+		copy(data[len(queued.data):], event.data)
+		queued.data = data
+	} else {
+		queued.data = append(queued.data, event.data...)
+	}
+	if event.err != nil {
+		queued.err = event.err
+	}
+	s.queuedBytes = size
+	return nil
+}
diff --git a/compat_review_test.go b/compat_review_test.go
new file mode 100644
--- /dev/null
+++ b/compat_review_test.go
@@ -0,0 +1,127 @@
+package expect
+
+import (
+	"context"
+	"io"
+	"net"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+)
+
+// Inspect only while holding the same gate as queue mutation; timing out here
+// also exposes a receiver that reserves that gate while waiting for future I/O.
+func waitQueuedBytes(t *testing.T, s *Session, want int) {
+	t.Helper()
+	ctx, cancel := context.WithTimeout(t.Context(), time.Second)
+	defer cancel()
+	tick := time.NewTicker(time.Millisecond)
+	defer tick.Stop()
+	for {
+		select {
+		case s.inputGate <- struct{}{}:
+			n := s.queuedBytes
+			<-s.inputGate
+			if n >= want {
+				return
+			}
+		case <-ctx.Done():
+			t.Fatalf("queued bytes did not become visible: want %d", want)
+		}
+		select {
+		case <-tick.C:
+		case <-ctx.Done():
+			t.Fatalf("queued bytes did not reach %d", want)
+		}
+	}
+}
+func TestSendAllQuietPeerQueuedPromptVisible(t *testing.T) {
+	a, b := net.Pipe()
+	s, e := NewSession(a)
+	if e != nil {
+		t.Fatal(e)
+	}
+	defer s.Close()
+	defer b.Close()
+	ctx, cancel := context.WithTimeout(t.Context(), 3*time.Second)
+	defer cancel()
+	sent := make(chan error, 1)
+	go func() { _, e := s.SendAll(ctx, "request"); sent <- e }()
+	if _, e = io.WriteString(b, "ready!"); e != nil {
+		t.Fatal(e)
+	}
+	waitQueuedBytes(t, s, len("ready!"))
+	r, e := s.Expect(ctx, []Case{{Pattern: Literal("ready!")}}, WithTimeout(100*time.Millisecond))
+	if e != nil || r.Match != "ready!" {
+		t.Fatalf("queued prompt hidden during write: match=%q err=%v", r.Match, e)
+	}
+	select {
+	case e := <-sent:
+		t.Fatalf("write completed before peer read: %v", e)
+	default:
+	}
+	got := make([]byte, len("request"))
+	if _, e = io.ReadFull(b, got); e != nil {
+		t.Fatal(e)
+	}
+	if string(got) != "request" {
+		t.Fatalf("request=%q", got)
+	}
+	if e = <-sent; e != nil {
+		t.Fatal(e)
+	}
+}
+
+type quietEOFTransport struct {
+	input      *strings.Reader
+	allowWrite chan struct{}
+	closed     chan struct{}
+	once       sync.Once
+}
+
+func (p *quietEOFTransport) Read(data []byte) (int, error) { return p.input.Read(data) }
+func (p *quietEOFTransport) Write(data []byte) (int, error) {
+	select {
+	case <-p.allowWrite:
+		return len(data), nil
+	case <-p.closed:
+		return 0, io.ErrClosedPipe
+	}
+}
+func (p *quietEOFTransport) Close() error { p.once.Do(func() { close(p.closed) }); return nil }
+func TestSendAllQuietPeerQueuedEOFVisible(t *testing.T) {
+	for _, tc := range []struct {
+		name, input string
+		limit       int
+	}{{"tail", "tail", 1024}, {"empty", "", 1}} {
+		t.Run(tc.name, func(t *testing.T) {
+			p := &quietEOFTransport{input: strings.NewReader(tc.input), allowWrite: make(chan struct{}), closed: make(chan struct{})}
+			s, e := NewSession(p, WithBufferLimit(tc.limit))
+			if e != nil {
+				t.Fatal(e)
+			}
+			defer s.Close()
+			ctx, cancel := context.WithTimeout(t.Context(), time.Second)
+			defer cancel()
+			sent := make(chan error, 1)
+			go func() { _, e := s.SendAll(ctx, "request"); sent <- e }()
+			if tc.input != "" {
+				waitQueuedBytes(t, s, len(tc.input))
+			}
+			r, e := s.Expect(ctx, []Case{{Pattern: EOF()}}, WithTimeout(100*time.Millisecond))
+			if e != nil || r.Before != tc.input {
+				t.Fatalf("tail=%q err=%v", r.Before, e)
+			}
+			select {
+			case e := <-sent:
+				t.Fatalf("write completed before permission: %v", e)
+			default:
+			}
+			close(p.allowWrite)
+			if e = <-sent; e != nil {
+				t.Fatal(e)
+			}
+		})
+	}
+}
diff --git a/compat_review_unix_test.go b/compat_review_unix_test.go
new file mode 100644
--- /dev/null
+++ b/compat_review_unix_test.go
@@ -0,0 +1,78 @@
+//go:build linux || darwin
+
+package expect
+
+import (
+	"context"
+	"io"
+	"strings"
+	"testing"
+	"time"
+	"unsafe"
+)
+
+func TestOSReadTransfersCompactTinyBuffer(t *testing.T) {
+	a, b := socketTransport(t)
+	access, e := newOSAccess(a)
+	if e != nil {
+		t.Fatal(e)
+	}
+	if _, e = b.Write([]byte("x")); e != nil {
+		t.Fatal(e)
+	}
+	data, e, ready := access.read(0)
+	if e != nil || !ready || string(data) != "x" {
+		t.Fatalf("data=%q ready=%v err=%v", data, ready, e)
+	}
+	if cap(data) > 2*len(data) {
+		t.Fatalf("tiny read retains capacity %d for %d byte", cap(data), len(data))
+	}
+}
+func TestSendAllTinyReadQueueRetainedMemoryAndPoll(t *testing.T) {
+	a, b := socketTransport(t)
+	const limit = 1024
+	s, e := NewSession(a, WithOSPolling(), WithBufferLimit(limit))
+	if e != nil {
+		t.Fatal(e)
+	}
+	defer s.Close()
+	ctx, cancel := context.WithTimeout(t.Context(), 5*time.Second)
+	defer cancel()
+	text := strings.Repeat("r", 2<<20)
+	sent := make(chan error, 1)
+	go func() { _, e := s.SendAll(ctx, text); sent <- e }()
+	for n := 1; n <= 256; n++ {
+		if _, e = b.Write([]byte("x")); e != nil {
+			t.Fatal(e)
+		}
+		waitQueuedBytes(t, s, n)
+	}
+	s.inputGate <- struct{}{}
+	payload := 0
+	for _, event := range s.queued {
+		payload += cap(event.data)
+	}
+	metadata := cap(s.queued) * int(unsafe.Sizeof(readEvent{}))
+	logical := s.queuedBytes
+	<-s.inputGate
+	if logical != 256 || payload+metadata > limit+int(unsafe.Sizeof(readEvent{})) {
+		t.Fatalf("logical=%d retained payload=%d metadata=%d limit=%d", logical, payload, metadata, limit)
+	}
+	r, e := s.Poll(ctx, []Case{{Pattern: Literal(strings.Repeat("x", 256))}})
+	if e != nil || len(r.Match) != 256 {
+		t.Fatalf("queued match hidden while write blocked: len=%d err=%v", len(r.Match), e)
+	}
+	select {
+	case e := <-sent:
+		t.Fatalf("write completed before peer read: %v", e)
+	default:
+	}
+	peer := make(chan error, 1)
+	go func() { _, e := io.CopyN(io.Discard, b, int64(len(text))); peer <- e }()
+	if e = <-sent; e != nil {
+		t.Fatal(e)
+	}
+	if e = <-peer; e != nil {
+		t.Fatal(e)
+	}
+}
diff --git a/compat_test.go b/compat_test.go
new file mode 100644
--- /dev/null
+++ b/compat_test.go
@@ -0,0 +1,265 @@
+package expect
+
+import (
+	"context"
+	"errors"
+	"io"
+	"net"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+)
+
+func TestDeclarationPriorityOptIn(t *testing.T) {
+	for _, priority := range []bool{false, true} {
+		t.Run(map[bool]string{false: "default", true: "declaration"}[priority], func(t *testing.T) {
+			a, b := net.Pipe()
+			s, _ := NewSession(a)
+			defer s.Close()
+			defer b.Close()
+			go func() { _, _ = io.WriteString(b, "early late") }()
+			var opts []ExpectOption
+			if priority {
+				opts = append(opts, WithDeclarationPriority())
+			}
+			r, e := s.Expect(t.Context(), []Case{{Pattern: Literal("late")}, {Pattern: Literal("early")}}, opts...)
+			want := 1
+			if priority {
+				want = 0
+			}
+			if e != nil || r.CaseIndex != want {
+				t.Fatalf("case=%d err=%v", r.CaseIndex, e)
+			}
+		})
+	}
+}
+func TestStreamingFallbackRetainsBoundary(t *testing.T) {
+	a, b := net.Pipe()
+	s, _ := NewSession(a, WithBufferLimit(64<<10))
+	defer s.Close()
+	defer b.Close()
+	input := strings.Repeat("x", (64<<10)-2) + "boundary!"
+	go func() { _, _ = io.WriteString(b, input) }()
+	var streamed string
+	r, e := s.Expect(t.Context(), []Case{{Pattern: Literal("boundary!")}}, WithStreamingFallback(func(_ context.Context, _ *Session, r Result) (Action, error) {
+		streamed += r.Match
+		return Continue, nil
+	}))
+	if e != nil || len(streamed) != 32<<10 || streamed+r.Before+r.Match != input {
+		t.Fatalf("streamed=%d before=%d match=%q err=%v", len(streamed), len(r.Before), r.Match, e)
+	}
+}
+func TestStreamingFallbackDoesNotResetTimeout(t *testing.T) {
+	a, b := net.Pipe()
+	s, _ := NewSession(a)
+	defer s.Close()
+	defer b.Close()
+	go func() {
+		for {
+			if _, e := io.WriteString(b, strings.Repeat("x", 64<<10)); e != nil {
+				return
+			}
+		}
+	}()
+	start := time.Now()
+	_, e := s.Expect(t.Context(), []Case{{Pattern: Literal("never")}}, WithTimeout(40*time.Millisecond), WithStreamingFallback(func(context.Context, *Session, Result) (Action, error) { return Continue, nil }))
+	if !errors.Is(e, ErrTimeout) || time.Since(start) > time.Second {
+		t.Fatalf("err=%v", e)
+	}
+}
+
+type suffixTransport struct {
+	mu     sync.Mutex
+	got    string
+	closed chan struct{}
+	once   sync.Once
+	fail   bool
+}
+
+func (p *suffixTransport) Read([]byte) (int, error) { <-p.closed; return 0, io.EOF }
+func (p *suffixTransport) Close() error             { p.once.Do(func() { close(p.closed) }); return nil }
+func (p *suffixTransport) Write(b []byte) (int, error) {
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	n := min(2, len(b))
+	p.got += string(b[:n])
+	if p.fail && len(p.got) >= 4 {
+		return n, io.ErrClosedPipe
+	}
+	return n, nil
+}
+func TestSendAllSuffixAndDefaultSend(t *testing.T) {
+	for _, all := range []bool{false, true} {
+		t.Run(map[bool]string{false: "send", true: "all"}[all], func(t *testing.T) {
+			p := &suffixTransport{closed: make(chan struct{})}
+			s, _ := NewSession(p)
+			defer s.Close()
+			var n int
+			var e error
+			if all {
+				n, e = s.SendAll(t.Context(), "abcdef")
+			} else {
+				n, e = s.Send(t.Context(), "abcdef")
+			}
+			if all {
+				if n != 6 || e != nil || p.got != "abcdef" {
+					t.Fatalf("n=%d err=%v got=%q", n, e, p.got)
+				}
+			} else if n != 2 || !errors.Is(e, io.ErrShortWrite) {
+				t.Fatalf("n=%d err=%v", n, e)
+			}
+		})
+	}
+}
+func TestSendAllFailureProgressCloses(t *testing.T) {
+	p := &suffixTransport{closed: make(chan struct{}), fail: true}
+	s, _ := NewSession(p)
+	n, e := s.SendAll(t.Context(), "abcdef")
+	var w *WriteError
+	if n != 4 || !errors.As(e, &w) || w.Written != 4 || !s.isClosed() || p.got != "abcd" {
+		t.Fatalf("n=%d err=%v got=%q", n, e, p.got)
+	}
+}
+func TestStandaloneRedactorScopedSwitch(t *testing.T) {
+	r, e := NewRedactor([]string{"secret"}, "[X]")
+	if e != nil {
+		t.Fatal(e)
+	}
+	out := string(r.Append([]byte("a sec")))
+	tail, e := r.SetSecrets(nil)
+	if e != nil {
+		t.Fatal(e)
+	}
+	out += string(tail) + string(r.Append([]byte("ret"))) + string(r.Finish())
+	if out != "a [X]ret" {
+		t.Fatalf("got %q", out)
+	}
+	r2, _ := NewRedactor(nil, "?")
+	if string(r2.Append([]byte("secret"))) != "secret" {
+		t.Fatal("rules escaped scope")
+	}
+}
+func TestPollUnsupported(t *testing.T) {
+	a, b := net.Pipe()
+	defer b.Close()
+	s, _ := NewSession(a)
+	defer s.Close()
+	_, e := s.Poll(t.Context(), []Case{{Pattern: Literal("x")}})
+	if !errors.Is(e, ErrPollUnsupported) {
+		t.Fatal(e)
+	}
+}
+
+func TestSendAllCancellationAndBackpressureLimit(t *testing.T) {
+	for _, overflow := range []bool{false, true} {
+		t.Run(map[bool]string{false: "canceled", true: "overflow"}[overflow], func(t *testing.T) {
+			a, b := net.Pipe()
+			s, _ := NewSession(a, WithBufferLimit(16<<10))
+			defer s.Close()
+			defer b.Close()
+			ctx, cancel := context.WithTimeout(t.Context(), 30*time.Millisecond)
+			defer cancel()
+			if overflow {
+				go func() { _, _ = io.WriteString(b, strings.Repeat("o", 128<<10)) }()
+			}
+			n, e := s.SendAll(ctx, strings.Repeat("i", 128<<10))
+			want := error(context.DeadlineExceeded)
+			if overflow {
+				want = ErrBufferLimit
+			}
+			if n != 0 || !errors.Is(e, want) || !s.isClosed() {
+				t.Fatalf("n=%d err=%v", n, e)
+			}
+		})
+	}
+}
+func TestStreamingOrdinaryMatchBeforeFallback(t *testing.T) {
+	a, b := net.Pipe()
+	s, _ := NewSession(a)
+	defer s.Close()
+	defer b.Close()
+	input := strings.Repeat("x", 64<<10) + "end"
+	go func() { io.WriteString(b, input) }()
+	called := false
+	r, e := s.Expect(t.Context(), []Case{{Pattern: Literal(strings.Repeat("x", 64<<10))}}, WithStreamingFallback(func(context.Context, *Session, Result) (Action, error) { called = true; return Return, nil }))
+	if e != nil || called || len(r.Match) != 64<<10 {
+		t.Fatalf("called=%v len=%d err=%v", called, len(r.Match), e)
+	}
+}
+func TestStreamingRedactorChunkOverlap(t *testing.T) {
+	for _, chunk := range []int{1, 2, 3, 7, 100} {
+		t.Run(string(rune('a'+chunk)), func(t *testing.T) {
+			r, _ := NewRedactor([]string{"aba", "bab", "secret"}, "[X]")
+			input := "xabababy secret sec"
+			var out []byte
+			for len(input) > 0 {
+				n := min(chunk, len(input))
+				out = append(out, r.Append([]byte(input[:n]))...)
+				input = input[n:]
+			}
+			out = append(out, r.Finish()...)
+			if string(out) != "x[X]y [X] [X]" {
+				t.Fatalf("got %q", out)
+			}
+		})
+	}
+}
